{
  "name": "eisax-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight local documents and presentations with optional AI assistance",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node -e \"require('node:fs').rmSync('.data',{recursive:true,force:true});console.log('cleared .data')\"",
    "local": "node scripts/local.mjs",
    "local:dev": "node scripts/local.mjs --dev",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "electron .",
    "desktop:package": "npm run desktop:prepare && electron-builder --win nsis"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tiptap/extension-color": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-table-cell": "^3.34.0",
    "@tiptap/extension-table-header": "^3.34.0",
    "@tiptap/extension-table-row": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "docx": "^9.15.4",
    "drizzle-orm": "^0.39.3",
    "jszip": "^3.10.2",
    "next": "^15.2.4",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.eisax.studio",
    "productName": "EISAX Studio",
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!.env*",
          "!**/.env*",
          "!.data/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "app": "desktop",
      "output": "dist"
    },
    "npmRebuild": false
  }
}
