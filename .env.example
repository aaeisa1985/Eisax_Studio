# EISAX Studio environment example — copy to .env.local
# NOTHING here is required to run locally. No external/paid service is contacted by default.

# --- Core ---
# Local dev uses embedded PGlite regardless of this value.
# When a real Postgres host is approved later, set a standard Postgres URL and
# change the driver adapter in src/lib/db/index.ts.
DATABASE_URL="pglite://local/eisax-studio"

# Secret used to derive session token hashes (CHANGE for any shared deployment).
AUTH_SECRET="dev-only-secret-change-me"

# --- AI provider (Phase 3) ---
# Leave unset to use the deterministic offline DEMO provider. Do not paste real
# provider keys unless you own the account and approve the external calls.
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL=""
# AI_MODEL=""
# AI_API_KEY=""

# --- Email (Phase 1+, optional) ---
# If unset, email verification / password reset is disabled (disclosed in STATUS.md).
# SMTP_URL=""

# --- Billing (Phase 5) ---
# Billing stays hard-disabled until explicitly approved. Feature flag below must
# remain false; Stripe keys are stored only in the server environment.
FEATURE_BILLING=false
# STRIPE_WEBHOOK_SECRET=""
